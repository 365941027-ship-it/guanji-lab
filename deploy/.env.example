# 观己实验室 · 服务器环境变量模板
# 用法：复制为项目根目录的 .env 后填入真实值
#   cp deploy/.env.example .env
#
# 注意：.env 里有真实密钥，不要提交到 Git（已在 .gitignore 里排除）。

# ===== 数据库（账号 / 会话 / 档案）=====
# 自建 PostgreSQL 容器 guanji-postgres 的连接信息。
# 这些变量缺失时，注册 / 登录 / 档案读写都会失败。
DB_HOST=guanji-postgres
DB_PORT=5432
DB_NAME=guanji
DB_USER=guanji
DB_PASSWORD=

# ===== 模型通道（测试解读 / 人生设计 / 模拟推演）=====
# 在 https://platform.deepseek.com 创建 API Key，格式 sk-...
# 这是服务端持有的密钥，永远不要写进前端代码。
DEEPSEEK_API_KEY=

# ===== 内测门禁 =====
# GUAN_BETA_MODE=1 时，未持内测 Cookie 的访客只会看到内测码页面，所有 /api/* 也会被拦。
# 想对公众开放时改成 0。
GUAN_BETA_MODE=1
# 内测码：发给受邀朋友的邀请码，请改成别人猜不到的内容。
GUAN_BETA_CODE=

# ===== 付费墙（金数据 / 微信支付等收款方式）=====
# 1 开启，0 关闭。开启后测试结果页才会出现付费解锁入口。
GUAN_PAY_ENABLED=0
# 默认单次解读价格（元）
GUAN_PAY_PRICE=9.9
# 收款链接 JSON。default 为通用链接；可按测试键覆盖，例如：
# {"default":"https://jsjform.com/f/你的表单","guan_who_price":19.9}
GUAN_PAY_GOODS_JSON=
# 用户遇到支付问题时展示的支持邮箱
GUAN_PAY_SUPPORT_EMAIL=

# ===== 以下为历史遗留，当前功能已停用，留空即可 =====
# 早期版本用 Supabase 存账号与分享登记，现已改为上面的自建 PostgreSQL。
# 目前仅 api/claim.js（分享打开登记）与 api/keepalive.js 还读取这两个变量；
# 留空时这两个接口会返回「未配置」，不影响主流程。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
